APP_ADDR=:8080
APP_PUBLIC_URL=http://localhost:8080

# Keep false for plain HTTP local development. When first-party auth is enabled,
# Secure is the default unless this value is explicitly overridden.
COOKIE_SECURE=false
APP_FIRST_PARTY_AUTH_ENABLED=false
DATABASE_URL=

# New Supabase keys are preferred.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# 32 random bytes encoded as base64. Required for provider credentials and webhook signing secrets.
# Example: openssl rand -base64 32
APP_MASTER_KEY_B64=
